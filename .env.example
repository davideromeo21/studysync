# ── StudySync Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Database
# Local SQLite (default — no config needed):
#   Leave DATABASE_URL unset; the app creates database_v5.db automatically.
# Production PostgreSQL (Render / Supabase / Neon):
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Secret key — used for signing session tokens in production deployments.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_64_char_hex_string

# Environment tag (local | staging | production)
ENVIRONMENT=local
